      propertyPath: 'introDialogueSequence.Array.data[10]'
      value: "\uBC29\uD328 \uB4A4\uB85C \uC228\uC9C0 \uC54A\uACA0\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[11]'
      value: "\uC640\uB77C."
