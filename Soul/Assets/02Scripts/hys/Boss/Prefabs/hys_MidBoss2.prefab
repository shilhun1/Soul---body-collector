    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: introDialogueSequence.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'deathDialogueSequence.Array.data[0]'
      value: "\uB0B4 \uAC80\uC774... \uBA48\uCDC4\uB2E4\uACE0?"
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'deathDialogueSequence.Array.data[1]'
      value: "\uAC00\uB77C. \uB2E4\uC74C \uBB38\uC740 \uB124\uAC00 \uC5F4\uC5B4\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[0]'
      value: "\uBA48\uCDB0\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[1]'
      value: "\uD55C \uAC78\uC74C\uB3C4 \uB354 \uC624\uC9C0 \uB9C8\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[2]'
      value: "\uC5EC\uAE30\uB294 \uC655\uC2E4\uC758 \uCC98\uD615\uC7A5\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[3]'
      value: "\uB098\uB294 \uAE30\uC0AC\uB2E8\uC7A5 \uBC14\uB974\uCE78."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[4]'
      value: "\uC655\uBA85\uC744 \uBC1B\uB4E4\uC5B4 \uBC18\uC5ED\uC790\uB97C \uBCA0\uC5C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[5]'
      value: "\uADF8 \uC218\uB97C \uC138\uB294 \uC77C\uC740 \uC624\uB798\uC804\uC5D0
        \uADF8\uB9CC\uB480\uC9C0."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[6]'
      value: "\uC8C4\uC758 \uBB34\uAC8C\uB294 \uC655\uAED8\uC11C \uC815\uD55C\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[7]'
      value: "\uB098\uB294 \uAC80\uC744 \uB0B4\uB9B4 \uBFD0\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[8]'
      value: "\uB124\uAC00 \uAC78\uCE5C \uC721\uC2E0\uB3C4 \uBE7C\uC557\uC740 \uAC83\uC774\uACA0\uC9C0."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[9]'
      value: "\uADF8\uB807\uB2E4\uBA74 \uC601\uD63C\uAE4C\uC9C0 \uC2EC\uBB38\uD558\uACA0\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: phaseTwoDialogueSequence.Array.size
