    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'introDialogueSequence.Array.data[12]'
      value: "\uB124 \uCDA9\uC131\uC744 \uD53C\uB85C \uC99D\uBA85\uD574\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 5114194407865569662, guid: 4b5c6d7e8f9a4b6c8d0e1f2a3b4c5d6e, type: 3}
      propertyPath: 'phaseTwoDialogueSequence.Array.data[0]'
